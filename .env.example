OPENAI_API_KEY=your-api-key
OPENAI_API_BASE=https://api.openai.com/v1
MODEL=gpt-4o-mini
WORKSPACE=./workspace
MAX_STEPS=6

# Per-session short-term window. Counts complete user turns, not messages.
SESSION_WINDOW_TURNS=20
MEMORY_SEARCH_RESULTS=5

# Optional explicit model context window in tokens. When unset, my-agent uses
# a built-in prefix table (unknown models fall back to 32768).
# MODEL_CONTEXT_WINDOW=128000

# Raw messages are queued on the request path and committed by one SQLite writer.
RAW_WRITE_BATCH_SIZE=32
RAW_WRITE_FLUSH_INTERVAL_MS=100
RAW_WRITE_QUEUE_CAPACITY=4096

# Turns leave SessionWindow for PendingBuffer. The worker extracts when either
# the batch size or oldest-wait threshold is reached.
EPISODIC_BATCH_TURNS=20
EPISODIC_MAX_WAIT_SECONDS=3600
EPISODIC_WORKER_POLL_SECONDS=60
EPISODIC_BODY_MAX_CHARS=60

# Episodic hybrid retrieval. Semantic MEMORY.md is injected separately.
MEMORY_EMBEDDING_PROVIDER=local
MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEMORY_EMBEDDING_DEVICE=cpu
MEMORY_EMBEDDING_LOCAL_FILES_ONLY=false
MEMORY_VECTOR_BACKEND=auto
MEMORY_CANDIDATE_LIMIT=30
MEMORY_RRF_K=60
MEMORY_SEMANTIC_MAX_CHARS=20000

# Shell tool execution timeout in seconds. The code clamps this to a maximum
# of 30 seconds.
BASH_TIMEOUT=20

# Bash always executes inside this project-owned Docker image. Build it once
# with: docker build -f docker/sandbox/Dockerfile -t my-agent-sandbox:py311-v1 .
SANDBOX_ENABLED=true
SANDBOX_IMAGE=my-agent-sandbox:py311-v1
SANDBOX_NETWORK=none
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_USER=65532:65532

# Channels to start, comma-separated. Options: cli, feishu
CHANNELS=cli

# Feishu (only needed when "feishu" is in CHANNELS). Websocket long-connection
# mode — no public IP / webhook required. Get these from the Feishu Open
# Platform app console: https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Web search (Baidu Qianfan AI Search). Leave empty to keep web_search hidden
# from the model. Get the key from the Qianfan console.
QIANFAN_API_KEY=
QIANFAN_API_BASE=https://qianfan.baidubce.com/v2
WEB_SEARCH_TIMEOUT=15

# Scheduler (reminders / recurring tasks). APScheduler owns precise in-process
# timers while SQLite remains the durable source of truth. Results return to
# the channel where the task was created.
SCHEDULER_ENABLED=true
# Legacy JSON is imported once when state.db is empty; it is not mutated.
SCHEDULER_TASKS_PATH=./data/scheduler/tasks.json
STATE_DB_PATH=./data/state.db
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_MAX_WORKERS=2
OUTBOX_RELAY_INTERVAL_SECONDS=15
OUTBOX_RELAY_BATCH_SIZE=20
OUTBOX_DELIVERY_LEASE_SECONDS=120

# Daily dream. When scheduler is enabled, my-agent creates/maintains an
# internal memory_dream task with this cron expression. Default: every day at
# local midnight.
DAILY_DREAM_ENABLED=true
DAILY_DREAM_CRON=0 0 * * *

# Tool approval policy: risk_based (default), always, or never. In risk_based,
# R0/R1 run automatically and R2 waits for /approve or /deny. Scheduled R2
# calls park in waiting_approval without blocking the scheduler worker.
TOOL_APPROVAL_MODE=risk_based

# Local OpenTelemetry traces. Start docker-compose.observability.yml first.
MY_AGENT_OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=my-agent
OTEL_RESOURCE_ENVIRONMENT=local
MY_AGENT_OTEL_CAPTURE_CONTENT=true
MY_AGENT_OTEL_CONTENT_MAX_BYTES=1000000

# Feishu batches allowed streaming text into one message update.
FEISHU_STREAM_FLUSH_INTERVAL=0.75
FEISHU_STREAM_FLUSH_CHARS=120
